# 换行符统一为 LF。
#
# 这不是洁癖：本项目的产物是跑在 Linux 容器里的。
# 若在 Windows 上用默认 autocrlf 检出，quickstart.sh 会变成 CRLF，
# 在 Linux 上直接执行就是 "bad interpreter: /bin/sh^M"；
# Dockerfile 的行续接符与 nginx 配置也会受 CRLF 影响。
# 在仓库层面钉死 LF，谁检出、在哪检出都一致。
* text=auto eol=lf

# 显式声明（避免被 auto 误判为二进制而跳过转换）
Dockerfile        text eol=lf
Makefile          text eol=lf
Caddyfile         text eol=lf
*.sh              text eol=lf
*.conf            text eol=lf
*.js              text eol=lf
*.mjs             text eol=lf
*.py              text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.json            text eol=lf
*.md              text eol=lf
*.html            text eol=lf
*.css             text eol=lf
*.txt             text eol=lf

# 二进制素材：绝不转换、不做行尾归一化，也不参与 diff
*.webp            binary
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.ico             binary
*.woff            binary
*.woff2           binary
*.ttf             binary
*.mp3             binary
*.wav             binary

# 让 GitHub 别把这些算进语言统计
assets/**         linguist-generated
